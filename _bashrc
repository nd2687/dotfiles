#!/bin/bash
# ~/.bashrc - Bash 設定ファイル（非ログインシェル用）

#==============================================================================
# 基本設定
#==============================================================================

# 非対話モードでは何もしない
[ -z "$PS1" ] && return

# ターミナルの種類を明示的に指定（256色対応）
export TERM=xterm-256color

# ロケール設定（日本語UTF-8）
export LANG=ja_JP.UTF-8

# East Asian Ambiguous 文字幅問題への対処
export VTE_CJK_WIDTH=wide

#==============================================================================
# ヒストリ設定
#==============================================================================

# ヒストリの重複行と先頭スペース行を無視
export HISTCONTROL=ignoreboth

# ヒストリの最大保存数
export HISTSIZE=9999

# ヒストリの共有機能（複数ターミナル間で履歴を共有）
function share_history {
    history -a  # .bash_historyに前回コマンドを1行追記
    history -c  # 端末ローカルの履歴を一旦消去
    history -r  # .bash_historyから履歴を読み込み直す
}
PROMPT_COMMAND='share_history'

# ヒストリ追記モードをOFF（share_history関数で管理するため）
shopt -u histappend

#==============================================================================
# Shell オプション
#==============================================================================

# ウィンドウサイズの変更を自動検出
shopt -s checkwinsize

# Ctrl+S によるターミナル停止を無効化（ターミナルが利用可能な場合のみ）
if [ -t 0 ]; then
    stty stop undef
fi

# ディレクトリ補完時に末尾スラッシュを付ける
set mark-directories on

#==============================================================================
# プロンプト設定
#==============================================================================

# Git ブランチ名を取得する関数
function get_git_branch {
    local branch=$(git branch --show-current 2>/dev/null)
    if [ -n "$branch" ]; then
        echo " ($branch)"
    fi
}

# モダンなプロンプト表示（シアン色ディレクトリ、黄色Gitブランチ、緑色矢印）
# 例: ~/project (main) >
PS1='\[\e[36m\]\w\[\e[0m\]\[\e[33m\]$(get_git_branch)\[\e[0m\] \[\e[32m\]>\[\e[0m\] '

# Git のプロンプト表示で変更状態を表示
export GIT_PS1_SHOWDIRTYSTATE=1

#==============================================================================
# カラー設定
#==============================================================================

# ls コマンドのカラー設定（BSD/macOS形式）
export LSCOLORS=gxfxcxdxbxegedabagacad

#==============================================================================
# エイリアス
#==============================================================================

# ls コマンド（カラー表示）
alias ls='ls -G'
alias ll='ls -l'           # 詳細表示
alias la='ls -A'           # 隠しファイルも表示
alias l='ls -CF'           # カラム表示

# vi を vim にリダイレクト
alias vi="vim"

# Kubernetes のショートカット
alias k=kubectl

#==============================================================================
# SSH Agent 設定
#==============================================================================

# SSH Agent のソケットを固定パスにリンク（再接続時の利便性向上）
agent="$HOME/.ssh/ssh_auth_sock"
if [ -S "$agent" ]; then
    export SSH_AUTH_SOCK=$agent
elif [ ! -S "$SSH_AUTH_SOCK" ]; then
    export SSH_AUTH_SOCK=$agent
elif [ ! -L "$SSH_AUTH_SOCK" ]; then
    ln -snf "$SSH_AUTH_SOCK" $agent && export SSH_AUTH_SOCK=$agent
fi

#==============================================================================
# PATH 設定
#==============================================================================

# Homebrew のバイナリパス
export PATH=$(brew --prefix)/bin:$PATH

# Google Cloud SDK
export PATH="/Users/takashikawano/Tools/google-cloud-sdk/bin:$PATH"

#==============================================================================
# 補完設定
#==============================================================================

# Git コマンドの補完機能
if [ -f ~/.git-completion.bash ]; then
    source ~/.git-completion.bash
fi

# OpenShift CLI (oc) の補完機能
if command -v oc &> /dev/null; then
    source <(oc completion bash)
fi

# iTerm2のタブ表示
export PROMPT_COMMAND='echo -ne "\033];${PWD##*/}\007"'

#==============================================================================
# 終了
#==============================================================================
